<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WinAppTicTacToe.MainPage"
             Title="Tic-Tac-Toe"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="MenuLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="BoardButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="60" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="MinimumWidthRequest" Value="60" />
            <Setter Property="MinimumHeightRequest" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="#EEEEEE" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="BorderColor" Value="#BFBFBF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="88" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="88" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="#EEEEEE" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="BorderColor" Value="#BFBFBF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="28,*" BackgroundColor="White">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" BackgroundColor="#F5F5F5">
            <Label Grid.Column="0" Text="Archivo" Style="{StaticResource MenuLabel}" />
            <Label Grid.Column="1" Text="Ayuda" Style="{StaticResource MenuLabel}" />
            <Label Grid.Column="2" Text="Ver" Style="{StaticResource MenuLabel}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout WidthRequest="279"
                                 MaximumWidthRequest="279"
                                 HorizontalOptions="Center"
                                 Padding="10,6,10,8"
                                 Spacing="7">
                <Border HeightRequest="95" Stroke="#D0D0D0" StrokeShape="Rectangle" Padding="6">
                    <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                        <Border Grid.Column="0" HeightRequest="64" WidthRequest="64" BackgroundColor="#E7F4FA" Stroke="#D0D0D0" StrokeShape="Rectangle">
                            <Image Source="pocoyo_bailando.gif"
                                   IsAnimationPlaying="True"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="Personaje bailando" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Horas de diversión"
                               FontSize="20"
                               FontAttributes="Bold"
                               VerticalTextAlignment="Center"
                               SemanticProperties.HeadingLevel="Level1" />
                    </Grid>
                </Border>

                <Border HeightRequest="225" Stroke="#D0D0D0" StrokeShape="Rectangle" Padding="30,19,30,19">
                    <Grid x:Name="BoardGrid"
                          RowDefinitions="60,60,60"
                          ColumnDefinitions="60,60,60"
                          RowSpacing="6"
                          ColumnSpacing="6"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <Button Grid.Row="0" Grid.Column="0" ClassId="0" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 1, vacía" />
                        <Button Grid.Row="0" Grid.Column="1" ClassId="1" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 2, vacía" />
                        <Button Grid.Row="0" Grid.Column="2" ClassId="2" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 3, vacía" />
                        <Button Grid.Row="1" Grid.Column="0" ClassId="3" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 4, vacía" />
                        <Button Grid.Row="1" Grid.Column="1" ClassId="4" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 5, vacía" />
                        <Button Grid.Row="1" Grid.Column="2" ClassId="5" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 6, vacía" />
                        <Button Grid.Row="2" Grid.Column="0" ClassId="6" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 7, vacía" />
                        <Button Grid.Row="2" Grid.Column="1" ClassId="7" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 8, vacía" />
                        <Button Grid.Row="2" Grid.Column="2" ClassId="8" Style="{StaticResource BoardButton}" Clicked="OnCellClicked" SemanticProperties.Description="Casilla 9, vacía" />
                    </Grid>
                </Border>

                <Border HeightRequest="60" Stroke="#D0D0D0" StrokeShape="Rectangle" Padding="20,8">
                    <Grid ColumnDefinitions="88,20,88" HorizontalOptions="Center">
                        <Button Grid.Column="0" Text="Nuevo" Style="{StaticResource OptionButton}" Clicked="OnNewClicked" SemanticProperties.Hint="Inicia una nueva partida" />
                        <Button Grid.Column="2" Text="Salir" Style="{StaticResource OptionButton}" Clicked="OnExitClicked" SemanticProperties.Hint="Cierra la aplicación en Windows" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
